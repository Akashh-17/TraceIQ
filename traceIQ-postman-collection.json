{
  "info": {
    "_postman_id": "traceiq-api-collection-v1",
    "name": "TraceIQ Backend API",
    "description": "Complete Postman collection for demonstrating TraceIQ multi-tenant audit log and security intelligence platform.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "tk_live_finstack_999",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. System Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": ["{{baseUrl}}"],
          "path": [""]
        },
        "description": "Check if API server and Redis/Database connections are healthy."
      }
    },
    {
      "name": "2. Auth - Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.data && jsonData.data.accessToken) {",
              "    pm.collectionVariables.set('accessToken', jsonData.data.accessToken);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@finstack.com\",\n  \"password\": \"Admin123!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "login"]
        },
        "description": "Log in to get JWT access token for tenant dashboard endpoints."
      }
    },
    {
      "name": "3. Ingestion - Ingest Audit Event",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{apiKey}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"actor\": \"security_audit_bot@company.com\",\n  \"action\": \"DATA_EXPORTED\",\n  \"resource_type\": \"USER\",\n  \"resource_id\": \"usr_998811\",\n  \"source_service\": \"ADMIN_PANEL\",\n  \"metadata\": {\n    \"records_exported\": 50000,\n    \"ip_address\": \"198.51.100.42\",\n    \"browser\": \"Chrome/122.0\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/events",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "events"]
        },
        "description": "Machine-to-machine ingestion endpoint. Returns 202 Accepted instantly and pushes to BullMQ."
      }
    },
    {
      "name": "4. Dashboard - Get Stats & KPIs",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/dashboard/stats",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "dashboard", "stats"]
        },
        "description": "Fetch aggregated dashboard statistics (cached in Redis for 60s)."
      }
    },
    {
      "name": "5. Events - Query & Filter Audit Logs",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/events?limit=10&page=1&action=DATA_EXPORTED",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "events"],
          "query": [
            { "key": "limit", "value": "10" },
            { "key": "page", "value": "1" },
            { "key": "action", "value": "DATA_EXPORTED" }
          ]
        },
        "description": "Search and filter tenant audit events."
      }
    },
    {
      "name": "6. Detections - View Security Alerts",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/detections",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "detections"]
        },
        "description": "Retrieve security anomaly detection alerts generated by the detection engine."
      }
    },
    {
      "name": "7. AI - Investigate Anomaly",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"Analyze suspicious DATA_EXPORTED events in the last 24 hours for actor security_audit_bot@company.com\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/ai/investigate",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "ai", "investigate"]
        },
        "description": "Triggers the LangGraph AI agent pipeline to analyze audit trails and generate security root cause reports."
      }
    }
  ]
}
