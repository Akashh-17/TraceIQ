// =============================================================================
// TraceIQ — Prisma Schema
// =============================================================================
//
// This file is the SINGLE SOURCE OF TRUTH for the database structure.
// If you want to know what tables/columns exist — read this file.
//
// After any change to this file:
//   1. Run: npx prisma migrate dev --name <describe_the_change>
//   2. Run: npx prisma generate   (auto-runs after migrate dev)
//
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // NOTE: In Prisma v7, the connection URL is configured in prisma.config.ts
  // (at the project root), NOT here. See prisma.config.ts for the actual URL.
}

// =============================================================================
// ENUMS
// =============================================================================

enum Role {
  SUPER_ADMIN
  TENANT_ADMIN
  AUDITOR
  ANALYST
  VIEWER
}

enum DetectionSeverity {
  LOW
  MEDIUM
  HIGH
}

enum DetectionStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}


// =============================================================================
// MODEL: Tenant
// Represents a company/organization using TraceIQ.
// Every other entity is scoped to a tenant.
// =============================================================================

model Tenant {
  // Primary key — UUID generated by the database
  id        String   @id @default(uuid()) @db.Uuid

  // Human-readable company name (e.g. "Acme Corp", "FinBank Ltd")
  // Used in dashboards and admin views
  name      String

  // The secret key this tenant includes in every API request header
  // (Authorization: Bearer tk_live_...) to authenticate themselves.
  // Must be globally unique — one key maps to exactly one tenant.
  apiKey    String   @unique

  // Automatically managed timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt       // Prisma updates this on every save

  // Relations — a tenant owns all of these
  auditEvents      AuditEvent[]
  users            User[]
  detections       Detection[]
  investigations   Investigation[]
  webhookConfig    WebhookConfig?

  // Map to snake_case table name (PostgreSQL convention)
  @@map("tenants")
}

// =============================================================================
// MODEL: AuditEvent
// The core entity. Every action recorded by TraceIQ is one row here.
// This table will be the largest and most queried — indexes are critical.
//
// Immutability rule: Once written, these records NEVER change.
// No updatedAt. No soft deletes. The audit log is sacred.
// =============================================================================

model AuditEvent {
  // Primary key — UUID generated by the application before insertion
  // (allows ID generation before touching the DB — important for queue-based writes in Phase 6)
  id           String   @id @default(uuid()) @db.Uuid

  // Foreign key — which tenant does this event belong to?
  // Every single query filters by this column first.
  tenantId     String   @db.Uuid
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  // WHO performed the action — typically an email address
  // e.g. "admin@acmecorp.com", "system@traceiq.io"
  actor        String

  // WHAT happened — must be UPPERCASE_WITH_UNDERSCORES (validated by Zod at API layer)
  // e.g. "LOGIN_SUCCESS", "TRANSACTION_APPROVED", "USER_DELETED"
  // Stored as a free string (not enum) because tenants define their own action types.
  action       String

  // WHAT TYPE of resource was affected
  // e.g. "transaction", "user", "document", "subscription"
  resourceType String

  // WHICH SPECIFIC resource was affected — the resource's own ID
  // e.g. "txn_12345", "user_789", "doc_abc"
  resourceId   String

  // WHY / CONTEXT — flexible JSON data that varies by event type
  // Examples:
  //   LOGIN_SUCCESS:         { "ip": "192.168.1.1", "browser": "Chrome" }
  //   TRANSACTION_APPROVED:  { "amount": 50000, "currency": "INR" }
  //   FILE_DOWNLOADED:       { "filename": "report.pdf", "size_bytes": 1024 }
  // JSONB = binary JSON — allows indexing and fast querying inside the JSON
  metadata     Json?

  // WHICH INTERNAL SERVICE generated this event?
  sourceService String

  // AI Embeddings
  nlRepresentation String?
  embedding        Float[]

  // WHEN — set automatically at insert time, never modified
  createdAt    DateTime @default(now())

  // ── INDEXES ──────────────────────────────────────────────────────────────
  // Every common query pattern gets an index.
  // Without indexes, PostgreSQL does a full table scan on millions of rows.

  // Most common query: "show me all events for tenant X, newest first"
  // This composite index covers the tenantId filter + createdAt sort in ONE lookup
  @@index([tenantId, createdAt(sort: Desc)])

  // "Show me all events by actor X (filtered by tenant)"
  @@index([tenantId, actor])

  // "Show me all LOGIN_FAILED events (filtered by tenant)"
  @@index([tenantId, action])

  // "Show me all events affecting resource txn_12345 (filtered by tenant)"
  @@index([tenantId, resourceType, resourceId])

  @@map("audit_events")
}

// =============================================================================
// MODEL: Detection
// =============================================================================
model Detection {
  id                 String            @id @default(uuid()) @db.Uuid
  tenantId           String            @db.Uuid
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor              String
  ruleName           String
  ruleDescription    String
  severity           DetectionSeverity
  status             DetectionStatus   @default(OPEN)
  metadata           Json?
  supportingEventIds String[]          @db.Uuid
  triggeredAt        DateTime          @default(now())

  @@index([tenantId, actor])
  @@index([tenantId, status])
  @@map("detections")
}

// =============================================================================
// MODEL: Investigation
// Persists every completed AI investigation so users can review history.
// =============================================================================
model Investigation {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // The user's original question
  query           String

  // Optional: the actor the investigation was focused on
  actor           String?

  // Structured output from the reporter node
  summary         String
  findings        String[]
  recommendations String[]

  createdAt       DateTime @default(now())

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("investigations")
}

// =============================================================================
// MODEL: WebhookConfig
// One webhook endpoint per tenant. When a detection fires, TraceIQ POSTs
// the detection payload to this URL (Slack, PagerDuty, custom endpoint, etc.)
// =============================================================================
model WebhookConfig {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @unique @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  url       String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("webhook_configs")
}

// =============================================================================
// MODEL: User
// Represents a human administrator who can log into the TraceIQ Dashboard.
// =============================================================================

model User {
  // Primary key — UUID
  id        String   @id @default(uuid()) @db.Uuid

  // Email is used for login. Must be globally unique across TraceIQ.
  email     String   @unique

  // Stored as a bcrypt hash. NEVER plain text.
  password  String

  // RBAC: The user's role. Defaults to VIEWER for safety.
  role      Role     @default(VIEWER)

  // Foreign key — Every user MUST belong to exactly ONE tenant.
  // This is the foundation of our multi-tenant security.
  tenantId  String   @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // One-to-Many relation to RefreshSessions
  sessions  RefreshSession[]

  // Tracks whether the user has completed the onboarding tour.
  // Stored server-side so it applies across all browsers and devices.
  hasCompletedOnboarding Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // We index tenantId because when we fetch users, we always filter by tenant
  @@index([tenantId])
  
  @@map("users")
}

// =============================================================================
// MODEL: RefreshSession
// Tracks active refresh tokens for Multi-Device support and Token Rotation.
// =============================================================================

model RefreshSession {
  id          String   @id @default(uuid()) @db.Uuid

  // The hashed refresh token. We never store plain text tokens!
  hashedToken String   @unique

  // To help the user identify which device this session is from.
  deviceName  String?

  // Timestamps for expiration and revocation
  expiresAt   DateTime
  revokedAt   DateTime? // If not null, the session is manually logged out
  lastUsedAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())

  // Foreign key to User
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_sessions")
}
