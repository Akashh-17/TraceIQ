# ─────────────────────────────────────────────────────────────────────────────
# TraceIQ — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── JWT Secrets ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
ACCESS_TOKEN_SECRET=replace_with_random_64_char_hex
REFRESH_TOKEN_SECRET=replace_with_another_random_64_char_hex

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/traceiq

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Google Gemini (free tier) ────────────────────────────────────────────────
# Enables event embeddings (worker) and AI investigation. Get a free key at
# https://aistudio.google.com — the app still runs without it, minus AI features.
GOOGLE_API_KEY=
# Optional overrides if Google renames its models
# GEMINI_CHAT_MODEL=gemini-flash-lite-latest
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ── CORS ─────────────────────────────────────────────────────────────────────
# The origin your frontend is served from
CORS_ORIGIN=http://localhost:5173
