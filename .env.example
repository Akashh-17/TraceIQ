# Copy this file to .env and fill in your values before running docker-compose.

# ── Authentication (required) ─────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET=replace-with-a-long-random-string
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-string

# ── AI: Google Gemini free tier (optional; enables investigation + semantic search)
# Get a free key at https://aistudio.google.com
GOOGLE_API_KEY=

# ── Local dev only (docker-compose overrides these for containers) ────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/traceiq
REDIS_URL=redis://localhost:6379

# ── Optional ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
CORS_ORIGIN=http://localhost:3001
