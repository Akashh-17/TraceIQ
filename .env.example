# ─────────────────────────────────────────────────────────────────────────────
# TraceIQ — Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Local:  postgresql://postgres:yourpassword@localhost:5432/audit_log_db
# Cloud:  Get this from Supabase / Neon / AWS RDS dashboard
DATABASE_URL=postgresql://user:password@localhost:5432/audit_log_db

# ── Redis ─────────────────────────────────────────────────────────────────────
# Used in Phase 6 (BullMQ job queue + caching)
REDIS_URL=redis://localhost:6379

# ── AWS S3 ────────────────────────────────────────────────────────────────────
# Used in Phase 9 (CSV/JSON export file storage + event archiving)
AWS_BUCKET_NAME=audit-logs-bucket
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
